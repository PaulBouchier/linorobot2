<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find linorobot2_description)/urdf/sensors/ld19_laser.urdf.xacro" />

  <xacro:macro name="ld19_laser_params" params="*origin">
    <xacro:ld19_laser
      update_rate="10"
      ray_count="360"
      min_angle="-3.1416"
      max_angle="3.1416"
      min_range="0.08"
      max_range="12.0"
      frame_id="laser"
      topic_name="scan"
    >
      <xacro:insert_block name="origin" />
    </xacro:ld19_laser>
  </xacro:macro>

</robot>