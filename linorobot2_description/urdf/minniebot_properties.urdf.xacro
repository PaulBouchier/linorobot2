<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:property name="base_length" value="0.14" />
  <xacro:property name="base_width" value="0.14" />
  <xacro:property name="base_height" value="0.003" />
  <xacro:property name="base_mass" value="0.5" />
  <!-- set empty on the wheel_mesh_file to use geometry instead of mesh -->
  <xacro:property name="base_mesh_file" value="" />
  <!-- <xacro:property name="base_mesh_file" value="file://$(find linorobot2_description)/meshes/base.dae" /> -->

  <xacro:property name="wheel_radius" value="0.04" />
  <xacro:property name="wheel_width" value="0.017" />
  <xacro:property name="wheel_pos_x" value="0.02" />
  <xacro:property name="wheel_pos_y" value="0.08" />
  <xacro:property name="wheel_pos_z" value="-0.011" />
  <xacro:property name="wheel_mass" value=".05" />
  <xacro:property name="wheel_torque" value="20" />
  <xacro:property name="front_caster_wheel" value="false" />
  <xacro:property name="rear_caster_wheel" value="true" />

  <!-- set empty on the wheel_mesh_file to use geometry instead of mesh -->
  <xacro:property name="wheel_mesh_file" value="" />
  <!-- <xacro:property name="wheel_mesh_file" value="file://$(find linorobot2_description)/meshes/tire.dae" /> -->
  
  <xacro:property name="imu_pose">
    <origin xyz="0.048 0.054 0.01" rpy="0 0 0"/>
  </xacro:property>

  <xacro:property name="laser_pose">
    <origin xyz="0.022 0 0.056" rpy="0 0 0"/>
  </xacro:property>

</robot>
